PORT=8080

# MongoDB persistence. If MongoDB is unavailable, Lumina still runs in memory for quick testing.
MONGODB_URI=mongodb://127.0.0.1:27017/lumina_pro_ai
MONGODB_DB=lumina_pro_ai

# Required for Lumina Chat, Builder code generation, prompt expansion, and Gemini image attempts.
# Create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=PASTE_YOUR_NEW_GEMINI_KEY_HERE

# Lumina AI text/code/chat models.
LUMINA_AI_MODEL=gemini-3.5-flash
LUMINA_CHAT_MODEL=gemini-3.5-flash
LUMINA_PROMPT_MODEL=gemini-3.5-flash
LUMINA_AI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-2.5-flash,gemini-1.5-flash

# Lumina visual engine. Auto tries Gemini native image first, then uses a real image provider fallback if quota is unavailable.
LUMINA_IMAGE_PROVIDER=auto
LUMINA_IMAGE_MODEL=gemini-3.1-flash-image-preview
LUMINA_IMAGE_FALLBACK_PROVIDER=pollinations
LUMINA_POLLINATIONS_MODEL=flux

# Optional local image generation. Requires AUTOMATIC1111/Forge API running locally.
LUMINA_LOCAL_SD_ENDPOINT=http://127.0.0.1:7860/sdapi/v1/txt2img
LUMINA_LOCAL_SD_STEPS=28
LUMINA_LOCAL_SD_CFG=7
LUMINA_LOCAL_SD_DENOISE=0.55

# Optional real code/text fallback providers if Gemini is overloaded or quota-limited.
# OpenRouter fallback: https://openrouter.ai/keys
OPENROUTER_API_KEY=
LUMINA_OPENROUTER_MODEL=google/gemini-flash-1.5
LUMINA_OPENROUTER_CODE_MODEL=anthropic/claude-3.5-sonnet

# Local fallback using Ollama or LM Studio-compatible local model server.
# Example: OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_BASE_URL=
LUMINA_OLLAMA_MODEL=qwen2.5-coder:7b
LUMINA_OLLAMA_CODE_MODEL=qwen2.5-coder:7b
